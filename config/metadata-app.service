[Unit]
Description=Metadata app
After=network.target

[Service]
Restart=always
WorkingDirectory=~/Apps/metadata-app/

ExecStart=/usr/bin/pipenv run gunicorn --workers 4 --bind localhost:8000 "application:create_app()" \
                                       --access-logfile /var/log/odoo/gunicorn-access.log --error-logfile /var/log/odoo/gunicorn-error.log

[Install]
WantedBy=multi-user.target
