[Unit]
Description=EcoSearch app
After=network.target

[Service]
User=lter-life
Group=lter-life
Restart=always
WorkingDirectory=/home/lter-life/Apps/EcoSearchEngine/

ExecStart=/home/lter-life/Apps/micromamba/envs/EcoSearchEngine/bin/gunicorn --workers 1 --bind localhost:8000 "app:create_app()" \
                                       --access-logfile /var/log/odoo/gunicorn-ecosearch-test-access.log \
                                       --error-logfile /var/log/odoo/gunicorn-ecosearch-test-error.log

[Install]
WantedBy=multi-user.target
