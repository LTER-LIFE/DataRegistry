# Docker Compose
# Use COMPOSE_PROJECT_NAME to separate the dev, test and prod environments
COMPOSE_PROJECT_NAME=eco-search-engine-dev

# Flask
FLASK_DEBUG=1
SECRET_KEY=
SESSION_COOKIE_SAMESITE=Lax
PORT=8000

# Database
# the DB_HOST is equal to the name of the docker-compose service
DB_HOST=database
DB_USER=ese_user
DB_PWD=supersecret
DB_NAME=ecosearchengine

# Database backup, enable in docker-compose.override.yml
BACKUP_DIR=/path/to/the/local/backup/folder
CRON_SCHEDULE=0 0 * * *
REMOVE_BEFORE=30

# Gunicorn
GUNICORN_RELOAD=1
GUNICORN_WORKERS=1

# LLM Metadata harvester
LLM_API_KEY=xxx
LLM_SERVICE_URL=http://localhost:8085
LLM_MODEL=gemini-2.5-flash

# Surf
SURF_CLIENT_ID=
SURF_CLIENT_SECRET=
SURF_DOTWELLKNOWN=https://proxy.sram.surf.nl/.well-known/openid-configuration
SURF_REDIRECT_URI=http://localhost:8000/authorized
SURF_SRAM_GROUP_PREFIX=urn:mace:surf.nl:sram:group:
SURF_SRAM_GROUP_POSTFIX=knaw:datamanagement:knawopenidtestap-ll_editor

# Elasticsearch
ELASTIC_STACK_VERSION=9.1.4
ELASTIC_CLUSTER_NAME="${COMPOSE_PROJECT_NAME}"
# 'es01' is equal to the name of the docker-compose service
ELASTIC_HOST=https://es01:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=supersecret
ELASTIC_LICENSE=basic
# Increase or decrease based on the available host memory (in bytes)
ELASTIC_MEM_LIMIT=1073741824
# The maximum number of results from a query. Elasticsearch has a hard max of 10000
ELASTIC_MAX_RESULTS=500
